<%#
  Renders a date input with per-segment error handling so the
  error summary can link to the specific invalid part and only that segment
  gets the govuk-input--error border.
%>
<%
attribute = local_assigns.fetch(:attribute)
form_obj = form.object
raw = form_obj.public_send(attribute)
values = case raw
        when ::Hash then { day: raw[3], month: raw[2], year: raw[1] }
        when ::Date then { day: raw.day, month: raw.month, year: raw.year }
        else             { day: nil, month: nil, year: nil }
        end

messages = form_obj.messages || {}
general_message = Array(messages[attribute]).first
part_messages = {
  day:   Array(messages[:"#{attribute}_day"]).first,
  month: Array(messages[:"#{attribute}_month"]).first,
  year:  Array(messages[:"#{attribute}_year"]).first
}

any_error = general_message.present? || part_messages.values.any?(&:present?)

visible_message =
  part_messages[:day] ||
  part_messages[:month] ||
  part_messages[:year] ||
  general_message

# Anchors the error summary generates via build_id('field-error', attribute_name:).
# Anchor format: "<object>-<attribute>-field-error" with underscores replaced by hyphens.
base_anchor = "#{form.object_name.to_s.tr('_', '-')}-#{attribute.to_s.tr('_', '-')}"
general_anchor = "#{base_anchor}-field-error"
part_anchor = ->(part) { "#{base_anchor}-#{part}-field-error" }

segments = [
  { part: :day, segment: "3i", width: 2 },
  { part: :month, segment: "2i", width: 2 },
  { part: :year, segment: "1i", width: 4 }
]
%>

<div class="govuk-form-group<%= " govuk-form-group--error" if any_error %>">
  <fieldset class="govuk-fieldset" role="group">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
      <h2 class="govuk-fieldset__heading"><%= legend %></h2>
    </legend>

    <% if hint.present? %>
      <div class="govuk-hint"><%= hint %></div>
    <% end %>

    <% if visible_message.present? %>
      <p class="govuk-error-message">
        <span class="govuk-visually-hidden">Error:</span> <%= visible_message %>
      </p>
    <% end %>

    <div class="govuk-date-input">
      <% segments.each do |seg| %>
        <%
          part = seg[:part]
          segment = seg[:segment]
          width = seg[:width]
          part_message = part_messages[part]
          highlight = part_message.present? || general_message.present?
          id = if part_message.present?
                 part_anchor.call(part)
               elsif general_message.present? && part == :day
                 # match the anchor the summary generates for the whole-field error
                 general_anchor
               else
              "#{form.object_name}_#{attribute}_#{segment}"
            end
        %>

        <div class="govuk-date-input__item">
          <div class="govuk-form-group">
            <%= tag.label part.to_s.capitalize, class: "govuk-label govuk-date-input__label", for: id %>
            <%= tag.input(
                  id: id,
                  class: "govuk-input govuk-date-input__input govuk-input--width-#{width}#{' govuk-input--error' if highlight}",
                  name: "#{form.object_name}[#{attribute}(#{segment})]",
                  type: "text",
                  inputmode: "numeric",
                  value: values[part],
                ) %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>
</div>