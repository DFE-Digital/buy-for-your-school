<% if get_expert_help.present? %>
<% homepage = local_assigns.fetch(:homepage, false) %>
<% top_padding = local_assigns.fetch(:top_padding, false) %>
<div class="<%= class_names('govuk-!-padding-bottom-2', 'govuk-!-padding-top-2': top_padding) %>">
  <h2 class="<%= class_names('govuk-heading-m': homepage, 'govuk-heading-s': !homepage, 'govuk-!-margin-top-2': top_padding) %>"><%= t(".heading") %></h2>
  <details class="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">
        <b><%= get_expert_help.title %></b>
      </span>
    </summary>
    <div class="govuk-details__text">
      <%= render_markdown_to_html(get_expert_help.description) %>
    </div>
  </details>
</div>
<% end %>
