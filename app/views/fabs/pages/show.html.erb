<h1 class="govuk-heading-l"><%= @page.title %></h1>

<p class="gem-c-lead-paragraph">
  <%= @page.description %>
</p>

<div>
  <%= render_markdown_to_html(@page.body) %>
</div>

<%= render partial: "shared/attachments", locals: { attachments: @page.attachments } %>

<% content_for :sidebar do %>
  <br /><br />
  <% if @page.show_request_help %>
    <%= render partial: "shared/get_expert_help", locals: { get_expert_help: @get_expert_help, top_padding: true } %>
  <% end %>
  <%= render partial: "shared/related_content", locals: { related_content: @page.related_content } %>
<% end %>
