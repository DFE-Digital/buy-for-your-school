
  <div class="dfe-width-container">
    <main class="govuk-main-wrapper">      
      <h1 class="govuk-heading-l"><%= t("search.title") %> <%= t("service.name") %></h1>
      <div class="dfe-grid-column-full-width">
        <%= render "search/full_width_search_box" %>
      </div>

      <div class="govuk-!-margin-top-6">
        <% unless @validation_error %>
          <h2 class="govuk-heading-m"><%= t("search.results_heading", count: @results_count, query: @query) %></h2>
        <% end %>
      </div>

      <% if @results.empty? %>
        <div class="govuk-!-margin-top-6">
          <h3 class="govuk-heading-s"><%= t("search.no_results.title") %></h3>
          <% if @validation_error %>
            <p class="govuk-body"><%= t("search.errors.#{@validation_error}") %></p>
          <% else %>
          <p class="govuk-body"><%= t("search.no_results.description") %></p>
          <% end %>
          <p class="govuk-body">
            <%= govuk_link_to t("search.no_results.cta"), root_path %>
          </p>
        </div>
      <% end %>

      <% if @results.any? %>
        <div class="search-results-section">
          <ul class="chevron-card-list">
            <% @results.each do |result| %>
              <li class="chevron-card">
                <div class="chevron-card__wrapper">
                  <h2 class="govuk-heading-s">
                    <%= govuk_link_to result.title, result.path, class: "govuk-link chevron-card__link" %>
                  </h2>
                  <p class="govuk-body-m chevron-card__description"><%= result.description %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </main>
  </div>
