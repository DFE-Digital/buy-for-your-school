<%= turbo_frame_tag "page_feedback" do %>
  <div class="gem-c-feedback gem-c-feedback__prompt gem-c-feedback__js-show js-prompt" tabindex="-1">
    <div class="gem-c-feedback__prompt-content dfe-width-container">
      <div class="gem-c-feedback__prompt-questions">
        <div class="gem-c-feedback__prompt-question-answer">
          <h2 class="gem-c-feedback__prompt-question">Is this page useful?</h2>
          <ul class="gem-c-feedback__option-list">
            <li class="gem-c-feedback__option-list-item">
              <%= button_to "Yes", form_page_feedbacks_path,
                    params: { page_url: @page_url, page_useful: true },
                    method: :get, class: "govuk-button gem-c-feedback__prompt-link" %>
            </li>
            <li class="gem-c-feedback__option-list-item">
              <%= button_to "No", ask_feedback_page_feedbacks_path,
                    params: { page_url: @page_url, page_useful: false },
                    method: :get, class: "govuk-button gem-c-feedback__prompt-link" %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>
