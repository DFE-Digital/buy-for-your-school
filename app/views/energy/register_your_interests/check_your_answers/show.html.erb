<% content_for :title, "Check your answers" %>
<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
  <h1 class="govuk-heading-l">Check your answers</h1>
  <%= govuk_summary_list do |list| %>
    <% { "Name" => [:name, energy_register_your_interest_path], "Email address" => [:email, energy_register_your_interest_email_path], "Preferred contact number" => [:phone_number, energy_register_your_interest_phone_number_path], "Multi-academy trust" => [:mat_name, energy_register_your_interest_mat_path], "UKPRN" => [:ukprn, energy_register_your_interest_mat_path], "Do you want to switch gas?" => [:switch_gas, energy_register_your_interest_gas_path], "Gas contract end date" => [:gas_contract_end_date, energy_register_your_interest_gas_path], "Do you want to switch electricity?" => [:switch_electricity, energy_register_your_interest_electricity_path], "Electricity contract end date" => [:electricity_contract_end_date, energy_register_your_interest_electricity_path] }.each do |label, (attribute, path)| %>
      <% value = @registration.public_send(attribute) %>
      <% value = value.nil? ? "Not provided" : value == true ? "Yes" : value == false ? "No" : value.respond_to?(:strftime) ? value.strftime("%-d %B %Y") : value %>
      <%= list.with_row do |row| %>
        <% row.with_key { label } %>
        <% row.with_value { value } %>
        <% row.with_action(text: "Change", href: "#{path}#{path.include?("?") ? "&" : "?"}return_to=check-answers", visually_hidden_text: label) %>
      <% end %>
    <% end %>
  <% end %>
  <%= button_to "Submit", energy_register_your_interest_check_your_answers_path, method: :post, class: "govuk-button" %>
</div></div>
