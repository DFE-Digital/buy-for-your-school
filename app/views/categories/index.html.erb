<%= content_for :pre_main do %>
  <div class="dfe-grid-row">
    <div class="dfe-grid-column-two-thirds">
      <h1 class="dfe-heading-xl homepage-heading">
        <%= t('header_title') %>
      </h1>
      <p class="govuk-body-l">
        <%= t('header_description') %>
        <ul class="govuk-body-l">
          <% t('header_bullets').each do |text| %>
            <li><%= text %></li>
          <% end %>
        </ul>
      </p>
    </div>
  </div>

  <% if @featured_offers.present? %>
    <div class="govuk-!-margin-top-7 govuk-!-padding-bottom-7">
      <h2 class="govuk-heading-m"><%= t(".offers_title") %></h2>
      <div class="dfe-grid-container">
        <%= render @featured_offers %>
      </div>
    </div>
  <% end %>

  <% if @popular_links.present? %>
    <div class="govuk-!-margin-top-2 govuk-!-padding-bottom-7">
      <h2 class="govuk-heading-m"><%= t(".popular_links_title") %></h2>
      <div class="homepage-popular-links">
        <%= render @popular_links %>
      </div>
    </div>
  <% end %>
<% end %>

<div id="buying-options-by-category">
  <h2 class="govuk-heading-m"><%= t(".title") %></h2>
  <p class="govuk-body"><%= t(".subtitle") %></p>
  <div class="homepage-category-list">
    <ul class="chevron-card-list">
      <%= render @categories %>
    </ul>
  </div>
  <% content_for :sidebar do %>
    <%= render partial: "shared/get_expert_help", locals: { get_expert_help: @get_expert_help, homepage: true } %>
  <% end %>
</div>


