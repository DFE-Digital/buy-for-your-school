<% content_for :page_header do %>
  <div class="govuk-grid-column-two-thirds govuk-!-margin-top-4">
    <h1 class="govuk-heading-l"><%= @page_title %></h1>
  </div>
<% end %>


<%= content_for :pre_main do %>
  <div class="govuk-!-margin-top-4 govuk-!-margin-bottom-4">
    <h2 class="govuk-heading-m govuk-!-margin-bottom-0"><%= @category.body_title %></h2>
    <p class="govuk-body-m"><%= @category.body_description %></p>
  </div>
  <% if @category.banner.present? %>
    <div class="govuk-grid-column-two-thirds govuk-!-padding-left-0 govuk-!-margin-bottom-4">
      <div class="promo-banner-container">
        <% if @category.banner.image&.url.present? %>
          <%= image_tag @category.banner.image.url, alt: @category.banner.title, class: 'promo-banner-image' %>
        <% end %>

        <%= render partial: "category_banner", locals: {
          title: @category.banner.title,
          description: @category.banner.description,
          url: @category.banner.url
        } %>
      </div>
    </div>
  <% end %>
<% end %>

<hr/>
<% if @solutions.present? %>
  <%= render partial: "shared/solution_section", locals: { solutions: @solutions, category_slug: @category_slug  } %>
<% end %>

<% content_for :sidebar do %>
  <%= render partial: "shared/right_filters", locals: { subcategories: @subcategories, category: @category, solutions: @solutions, ways_to_buy: @ways_to_buy } if @show_filter %>
  <%= render partial: "shared/get_expert_help", locals: { get_expert_help: @get_expert_help, first_item: !@show_filter } %>
  <%= render partial: "shared/related_content", locals: { related_content: @category.related_content } %>
<% end %>
